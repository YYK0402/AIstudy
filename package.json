{
  "name": "siyuan-ai-study",
  "version": "0.1.0",
  "type": "module",
  "description": "AI 智能学习插件：基于思源笔记底座 + 可自定义大模型服务商的课程自学插件",
  "author": "yyk",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:web": "vite build --config web/vite.config.ts",
    "build:plugin": "vite build --config vite.config.ts",
    "build": "npm run clean && npm run build:web && npm run build:plugin",
    "dev": "vite build --watch --config vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "make-install": "npm run build && node scripts/make_install.js",
    "make-link": "node scripts/make_dev_link.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "pinia": "^2.3.0",
    "siyuan": "^1.2.9",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-static-copy": "^1.0.6",
    "vitest": "^2.1.9",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299"
  }
}
